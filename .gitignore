# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Environment variables (may contain secrets)
.env
.env.*
!.env.example
# .env.e2e is the exception to the exception: every value in it is a fixed
# local placeholder (e2e-fake-*, http://127.0.0.1:54321) consumed only by
# e2e/mocks/*.ts — never a real credential. It has to be tracked for
# `npm run build:e2e` to work in CI, the same way .env.example is tracked
# for onboarding. See docs/E2E_TEST_REPORT.md § 1 for the full rationale.
!.env.e2e

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# Local database dumps produced by scripts/backup-database.sh — never
# committed, may contain customer data.
backups/

# Playwright E2E output (screenshots/videos/traces/HTML+JSON reports) —
# regenerated by every `npm run test:e2e`, never committed.
playwright-report/
test-results/
blob-report/

.claude/settings.json
supabase/.temp/
