# E2E test environment — points the app at the local mock server
# (e2e/mocks/ssr-bootstrap-server.ts) instead of real production Supabase.
# Loaded by Vite automatically for `vite build --mode e2e` /
# `vite preview --mode e2e`. Git-ignored via the existing `.env.*` rule —
# never contains a real secret, every value here is a fixed local
# placeholder read by the mock server, not by any real service.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=e2e-fake-publishable-key
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=e2e-fake-publishable-key

# Never actually read during E2E runs (client.server.ts is only imported
# by specific server functions our mocked flows fire-and-forget / never
# reach), set to a placeholder purely so nothing throws at import time.
SUPABASE_SERVICE_ROLE_KEY=e2e-fake-service-role-key

VAPID_SUBJECT=mailto:e2e@example.com
VAPID_PUBLIC_KEY=e2e-fake-vapid-public-key
VAPID_PRIVATE_JWK={"kty":"EC","crv":"P-256","x":"AAAA","y":"AAAA","d":"AAAA"}

RESEND_API_KEY=e2e-fake-resend-key
CRON_SECRET=e2e-fake-cron-secret

# MonCash left entirely unset — moncashProvider.isConfigured() must
# report false during E2E, matching the "inactive by default" production
# posture (see docs/PAYMENT_PROVIDERS.md); no test in this suite exercises
# a real MonCash redirect.
